{
  "name": "@ianlucas/cs2-inventory-simulator",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "prisma generate && react-router build",
    "dev": "react-router dev",
    "format": "prettier . --write",
    "lint": "eslint",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest",
    "translate": "tsx scripts/translate.ts && prettier app/translations/*.ts --write",
    "typecheck": "react-router typegen && tsc",
    "upgrade": "npx npm-check-updates@latest --target minor -u",
    "deploy:info": "node -e \"const c=require('./package.json').cloudflare;console.log('D1 绑定 DB: '+c.d1.database_name);console.log('');console.log('部署前请在仓库 Secrets 或 workflow_dispatch 输入中配置:');console.log('  D1_DATABASE_ID = '+c.d1.id);console.log('');console.log('获取现有资源 ID:');console.log('  npx wrangler d1 list --json | jq -r \\\".[].uuid\\\"');\""
  },
  "cloudflare": {
    "d1": {
      "binding": "DB",
      "database_name": "cs2-inventory-db",
      "id": "b7653ae2-637e-409a-8578-9649e9abcf7b",
      "migrations_dir": "./d1-migrations",
      "description": "D1 SQLite 数据库（用户/库存/Rule/经济数据）。部署时通过 D1_DATABASE_ID 环境变量或部署界面填入现有数据库 ID。"
    }
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@ianlucas/cs2-lib": "^9.0.0",
    "@ianlucas/cs2-lib-inspect": "^9.0.0",
    "@ianlucas/remix-auth-steam": "^8.0.1",
    "@prisma/adapter-d1": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-router/cloudflare": "^8.3.1",
    "@react-router/fs-routes": "^8.3.1",
    "@react-router/node": "^8.3.1",
    "@react-router/serve": "^8.3.1",
    "@uidotdev/usehooks": "^2.4.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "dotenv": "^17.4.2",
    "hash-object": "^5.1.0",
    "isbot": "^5.2.1",
    "lz-string": "^1.5.0",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "remix-auth": "^4.2.0",
    "remix-utils": "^10.0.0",
    "steamapi": "^3.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.1",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.50.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "workerd@1.20260828.1": true
  },
  "version": "0.0.1"
}
